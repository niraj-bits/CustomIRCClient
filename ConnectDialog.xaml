<Window x:Class="MyIRCClient.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to IRC" Height="340" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server Name or IP -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Name / IP:" VerticalAlignment="Center" Margin="0,0,10,12" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        <TextBox x:Name="ServerTextBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" Text="irc.librairc.net" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244"/>

        <!-- Port -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,10,12" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" Text="6697" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244"/>

        <!-- SSL / TLS Checkbox -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Security:" VerticalAlignment="Center" Margin="0,0,10,12" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        <CheckBox x:Name="SslCheckBox" Grid.Row="2" Grid.Column="1" Content="Use SSL / TLS (Required for +z rooms)" VerticalAlignment="Center" Margin="0,0,0,12" IsChecked="True" Foreground="#CDD6F4" Checked="SslCheckBox_CheckedChanged" Unchecked="SslCheckBox_CheckedChanged"/>

        <!-- Room / Channel Name -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Room Name:" VerticalAlignment="Center" Margin="0,0,10,12" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        <TextBox x:Name="RoomTextBox" Grid.Row="3" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" Text="#india" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244"/>

        <!-- Nickname -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nickname:" VerticalAlignment="Center" Margin="0,0,10,12" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        <TextBox x:Name="NicknameTextBox" Grid.Row="4" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" Text="nerd" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Connect" Width="85" Height="30" Margin="0,0,10,0" IsDefault="True" Click="ConnectButton_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancel" Width="85" Height="30" IsCancel="True" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
