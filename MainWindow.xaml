<Window x:Class="MyIRCClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyIRCClient" Height="700" Width="1050"
        MinHeight="500" MinWidth="800"
        FontFamily="Segoe UI" FontSize="13"
        Background="#1E1E2E" Foreground="#CDD6F4"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- User Context Menu (Right Pane) -->
        <ContextMenu x:Key="UserContextMenu">
            <MenuItem x:Name="SendMultiMessageMenuItem" Header="_Send Message to Selected..." Click="SendMultiMessageMenuItem_Click"/>
            <MenuItem Header="_Direct Message..." Click="UserDirectMessage_Click"/>
            <MenuItem Header="_Whois" Click="UserWhois_Click"/>
            <Separator/>
            <MenuItem Header="_Copy Nickname(s)" Click="UserCopyNick_Click"/>
        </ContextMenu>

        <!-- Conversation Context Menu (Left Pane) -->
        <ContextMenu x:Key="ConversationContextMenu">
            <MenuItem Header="_Close Conversation" Click="CloseConversation_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#181825" Foreground="#CDD6F4" Padding="5,3">
            <MenuItem Header="_Connect" Foreground="#CDD6F4" Padding="8,4">
                <MenuItem Header="_Server Settings / Connect..." Click="ConnectMenuItem_Click" Foreground="#1E1E2E"/>
                <Separator/>
                <MenuItem Header="_Disconnect" Click="DisconnectMenuItem_Click" Foreground="#1E1E2E"/>
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#11111B" Foreground="#A6ADC8" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Not connected. Click 'Connect' -> 'Server Settings / Connect...' to begin." />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Body Area -->
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <!-- Upper Row: 3-column split view (Conversations | Main Chat | Users) -->
                <RowDefinition Height="*"/>
                <!-- Splitter between Chat and Bottom Log Pane -->
                <RowDefinition Height="6"/>
                <!-- Lower Row: Server Errors & Logs Pane -->
                <RowDefinition Height="160" MinHeight="70"/>
            </Grid.RowDefinitions>

            <!-- Upper Row: Conversations (Left), Main Chat (Center), Users (Right) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Left Section: Channels & Direct Messages -->
                    <ColumnDefinition Width="200" MinWidth="130" MaxWidth="320"/>
                    <!-- Splitter 1 -->
                    <ColumnDefinition Width="6"/>
                    <!-- Center Section: Main Chat (Active Conversation) -->
                    <ColumnDefinition Width="*" MinWidth="350"/>
                    <!-- Splitter 2 -->
                    <ColumnDefinition Width="6"/>
                    <!-- Right Section: Users in room -->
                    <ColumnDefinition Width="220" MinWidth="150" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- Left Section: Conversations -->
                <Border Grid.Column="0" Background="#181825" CornerRadius="4" BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#11111B" CornerRadius="4,4,0,0" Padding="10,8" BorderBrush="#313244" BorderThickness="0,0,0,1">
                            <TextBlock Text="Conversations" FontWeight="SemiBold" Foreground="#89B4FA"/>
                        </Border>

                        <ListBox x:Name="ConversationsListBox" 
                                 Grid.Row="1" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#CDD6F4" 
                                 Margin="4"
                                 ContextMenu="{StaticResource ConversationContextMenu}"
                                 SelectionChanged="ConversationsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Channel / DM Icon Badge -->
                                        <Border Grid.Column="0" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChannel}" Value="True">
                                                            <Setter Property="Background" Value="#89B4FA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChannel}" Value="False">
                                                            <Setter Property="Background" Value="#CBA6F7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Icon}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="#11111B" 
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Conversation Name (Changes color to #FAB387 and becomes Bold when unread!) -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayName}" 
                                                   Foreground="{Binding TextColor}" 
                                                   FontWeight="{Binding FontWeight}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Unread Count Pill -->
                                        <Border Grid.Column="2" 
                                                Background="#FAB387" 
                                                CornerRadius="7" 
                                                Padding="5,1" 
                                                Margin="4,0,0,0"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding BadgeText}" 
                                                       FontSize="10" 
                                                       FontWeight="Bold" 
                                                       Foreground="#11111B" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter 1 (Conversations <-> Chat) -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#313244"
                              Cursor="SizeWE"
                              ShowsPreview="False"/>

                <!-- Center Section: Main Chat (Active Conversation) -->
                <Border Grid.Column="2" Background="#181825" CornerRadius="4" BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Room / Conversation Header -->
                        <Border Grid.Row="0" Background="#11111B" CornerRadius="4,4,0,0" Padding="12,8" BorderBrush="#313244" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="ChatHeaderTextBlock" Text="Chat / Messages" FontWeight="SemiBold" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Messages Display (Focusable=False to prevent grabbing focus) -->
                        <ScrollViewer x:Name="ChatScrollViewer" 
                                      Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled" 
                                      Padding="10"
                                      Focusable="False">
                            <TextBox x:Name="ChatMessagesTextBox" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="#CDD6F4" 
                                     IsReadOnly="True" 
                                     Focusable="False"
                                     IsTabStop="False"
                                     TextWrapping="Wrap"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     Text="Welcome to MyIRCClient! Click 'Connect' to begin."/>
                        </ScrollViewer>

                        <!-- Message Input Bar -->
                        <Border Grid.Row="2" Background="#11111B" CornerRadius="0,0,4,4" Padding="6" BorderBrush="#313244" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MessageInputTextBox" 
                                         Grid.Column="0" 
                                         Height="30" 
                                         VerticalContentAlignment="Center" 
                                         Padding="8,0" 
                                         Background="#181825" 
                                         Foreground="#CDD6F4" 
                                         BorderBrush="#313244"
                                         KeyDown="MessageInputTextBox_KeyDown"
                                         IsEnabled="False"/>
                                <Button x:Name="SendButton" 
                                        Grid.Column="1" 
                                        Content="Send" 
                                        Width="70" 
                                        Height="30" 
                                        Margin="6,0,0,0" 
                                        Click="SendButton_Click" 
                                        Background="#89B4FA" 
                                        Foreground="#11111B" 
                                        FontWeight="SemiBold" 
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Splitter 2 (Chat <-> Users) -->
                <GridSplitter Grid.Column="3"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#313244"
                              Cursor="SizeWE"
                              ShowsPreview="False"/>

                <!-- Right Section: Users in Room -->
                <Border Grid.Column="4" Background="#181825" CornerRadius="4" BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- User List Header -->
                        <Border Grid.Row="0" Background="#11111B" CornerRadius="4,4,0,0" Padding="10,8" BorderBrush="#313244" BorderThickness="0,0,0,1">
                            <TextBlock x:Name="UserListHeaderTextBlock" Text="Users (0)" FontWeight="SemiBold" Foreground="#F38BA8"/>
                        </Border>

                        <!-- Filter / Search Users Box -->
                        <Border Grid.Row="1" Background="#11111B" Padding="6,4" BorderBrush="#313244" BorderThickness="0,0,0,1">
                            <TextBox x:Name="UserFilterTextBox" 
                                     Height="24" 
                                     VerticalContentAlignment="Center" 
                                     Padding="6,0" 
                                     Background="#181825" 
                                     Foreground="#CDD6F4" 
                                     BorderBrush="#313244"
                                     TextChanged="UserFilterTextBox_TextChanged"
                                     ToolTip="Type to filter users..."/>
                        </Border>

                        <!-- User ListBox with Shift/Ctrl multi-selection -->
                        <ListBox x:Name="UsersListBox" 
                                 Grid.Row="2" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#CDD6F4" 
                                 Margin="4"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ContextMenu="{StaticResource UserContextMenu}"
                                 ContextMenuOpening="UsersListBox_ContextMenuOpening"
                                 PreviewMouseRightButtonDown="UsersListBox_PreviewMouseRightButtonDown"
                                 MouseDoubleClick="UsersListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <!-- Prefix icon / tag -->
                                        <Border CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOp}" Value="True">
                                                            <Setter Property="Background" Value="#EBA0AC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVoiced}" Value="True">
                                                            <Setter Property="Background" Value="#A6E3A1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Prefix, TargetNullValue=''}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="#11111B" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Nickname -->
                                        <TextBlock Text="{Binding Nickname}" 
                                                   Foreground="#CDD6F4" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Horizontal Splitter between Main View and Bottom Log Pane -->
            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#313244"
                          Cursor="SizeNS"
                          ShowsPreview="False"/>

            <!-- Bottom Section: Server Errors & Logs Pane -->
            <Border Grid.Row="2" Background="#11111B" CornerRadius="4" BorderBrush="#313244" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log Header with Clear Button -->
                    <Border Grid.Row="0" Background="#181825" CornerRadius="4,4,0,0" Padding="10,6" BorderBrush="#313244" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Server Errors &amp; Logs" FontWeight="SemiBold" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Clear Logs" Padding="8,2" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand" Click="ClearLogsButton_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Log Output Text Box -->
                    <TextBox x:Name="LogTextBox" 
                             Grid.Row="1" 
                             Background="#11111B" 
                             Foreground="#A6ADC8" 
                             BorderThickness="0" 
                             IsReadOnly="True" 
                             FontFamily="Consolas" 
                             FontSize="12" 
                             Padding="8" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto" 
                             TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
