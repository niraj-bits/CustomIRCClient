<Window x:Class="MyIRCClient.MultiUserMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Message to Selected Users" Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Recipients Header -->
        <TextBlock x:Name="RecipientsHeaderTextBlock" 
                   Grid.Row="0" 
                   Text="Send message to selected users:" 
                   FontWeight="SemiBold" 
                   Foreground="#89B4FA" 
                   Margin="0,0,0,6"/>

        <!-- Recipients summary -->
        <TextBlock x:Name="RecipientsListTextBlock" 
                   Grid.Row="1" 
                   Text="Recipients..." 
                   Foreground="#A6ADC8" 
                   FontSize="12"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,12"/>

        <!-- Message Body Input -->
        <TextBox x:Name="MessageInputTextBox" 
                 Grid.Row="2" 
                 Background="#181825" 
                 Foreground="#CDD6F4" 
                 BorderBrush="#313244"
                 Padding="8" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,14"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Send to All" 
                    Width="110" 
                    Height="32" 
                    Margin="0,0,10,0" 
                    IsDefault="True" 
                    Click="SendButton_Click" 
                    Background="#89B4FA" 
                    Foreground="#11111B" 
                    FontWeight="SemiBold" 
                    BorderThickness="0" 
                    Cursor="Hand"/>
            <Button Content="Cancel" 
                    Width="85" 
                    Height="32" 
                    IsCancel="True" 
                    Background="#313244" 
                    Foreground="#CDD6F4" 
                    BorderThickness="0" 
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
